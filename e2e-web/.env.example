# =============================================================================
# 🎭 e2e-web 環境変数（このファイルを .env にコピーして使用する。 .env はコミット禁止）
#    cp e2e-web/.env.example e2e-web/.env
# =============================================================================

# --- テスト対象 -------------------------------------------------------------
# テスト対象のベース URL。
# 指定すると webServer（ローカル静的サーバ）を起動せず、この URL に対してテストする。
# 例: デプロイ済み環境をテストする場合
#PLAYWRIGHT_BASE_URL=https://app.nanitabeyo.net

# ローカル静的サーバのポート（既定: 4173）。
# 変更した場合は api-development の CORS_ORIGIN にも新しいオリジンを追加すること。
#PLAYWRIGHT_PORT=4173

# --- 認証（ログイン済みテスト用） -------------------------------------------
# Supabase dev プロジェクトに事前作成したテストユーザーの認証情報。
# 未設定の場合、tests/authenticated/ 配下のテストは自動的にスキップされる。
# ※ Supabase 側で Email provider が ON（Allow new users to sign up は OFF 推奨）である必要がある
#TEST_USER_EMAIL=
#TEST_USER_PASSWORD=

# --- ミューテーションテスト -------------------------------------------------
# dev DB へ書き込むテスト（@mutation タグ）を実行する場合のみ 1 を設定する。
# 通常は pnpm test:mutation / pnpm test:all が内部で設定するため手動設定は不要。
#RUN_MUTATION=1

# --- 動画・スクリーンショットの強制収集（デバッグ用） -------------------------
# 既定では screenshot は失敗時のみ（only-on-failure）、video は失敗時のみ保持
# （retain-on-failure）で、成功したテストには何も残らない。
# 「実際に画面が動いている様子を確認したい」等、成功時の動画・スクショも見たい
# 一時的な確認作業のときだけ 1 を設定する。常用すると実行が重くなるため注意。
#PW_FORCE_VISUALS=1
