		},
		{
			"site": "oia-relay",
			"public": "app-expo/relay-public",
			"ignore": [
				"firebase.json",
				"**/.*",
				"**/node_modules/**"
			],
			"headers": [
				{
					"source": "**",
					"headers": [
						{
							"key": "Cache-Control",
							"value": "no-store"
						}
					]
				}
			]
		}
	]
