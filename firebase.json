{
	"hosting": [
		{
			"site": "food-scroll",
			"public": "app-expo/dist",
			"redirects": [
				{
					"source": "/:path*",
					"destination": "https://app.nanitabeyo.net/:path",
					"type": 301
				}
			]
		},
		{
			"site": "app-nanitabeyo-net",
			"public": "app-expo/dist",
			"ignore": [
				"firebase.json",
				"**/node_modules/**"
			],
			"headers": [
				{
					"source": "/sitemap.xml",
					"headers": [
						{
							"key": "Content-Type",
							"value": "application/xml; charset=utf-8"
						},
						{
							"key": "Cache-Control",
							"value": "public, max-age=3600"
						}
					]
				},
				{
					"source": "/robots.txt",
					"headers": [
						{
							"key": "Content-Type",
							"value": "text/plain; charset=utf-8"
						},
						{
							"key": "Cache-Control",
							"value": "public, max-age=3600"
						}
					]
				},
				{
					"source": "/favicon.ico",
					"headers": [
						{
							"key": "Content-Type",
							"value": "image/x-icon"
						},
						{
							"key": "Cache-Control",
							"value": "public, max-age=31536000, immutable"
						}
					]
				},
				{
					"source": "/favicon*.ico",
					"headers": [
						{
							"key": "Content-Type",
							"value": "image/x-icon"
						},
						{
							"key": "Cache-Control",
							"value": "public, max-age=31536000, immutable"
						}
					]
				},
				{
					"source": "/favicon-*.png",
					"headers": [
						{
							"key": "Content-Type",
							"value": "image/png"
						},
						{
							"key": "Cache-Control",
							"value": "public, max-age=31536000, immutable"
						}
					]
				},
				{
					"source": "/android-chrome-192x192.png",
					"headers": [
						{
							"key": "Content-Type",
							"value": "image/png"
						},
						{
							"key": "Cache-Control",
							"value": "public, max-age=31536000, immutable"
						}
					]
				},
				{
					"source": "/apple-touch-icon.png",
					"headers": [
						{
							"key": "Content-Type",
							"value": "image/png"
						},
						{
							"key": "Cache-Control",
							"value": "public, max-age=31536000, immutable"
						}
					]
				},
				{
					"source": "/manifest.json",
					"headers": [
						{
							"key": "Content-Type",
							"value": "application/manifest+json; charset=utf-8"
						},
						{
							"key": "Cache-Control",
							"value": "public, max-age=3600"
						}
					]
				},
				{
					"source": "/.well-known/apple-app-site-association",
					"headers": [
						{
							"key": "Content-Type",
							"value": "application/json"
						}
					]
				},
				{
					"source": "/.well-known/assetlinks.json",
					"headers": [
						{
							"key": "Content-Type",
							"value": "application/json"
						}
					]
				},
				{
					"source": "/apple-app-site-association",
					"headers": [
						{
							"key": "Content-Type",
							"value": "application/json"
						}
					]
				}
			],
			"cleanUrls": true,
			"rewrites": [
				{
					"source": "/s/**",
					"run": {
						"serviceId": "api-production",
						"region": "asia-northeast1"
					}
				},
				{
					"source": "/ja-JP/search/dish-category-group-votes/**",
					"destination": "/ja-JP/search/dish-category-group-votes/[shareToken]/vote.html"
				},
				{
					"source": "/en-US/search/dish-category-group-votes/**",
					"destination": "/en-US/search/dish-category-group-votes/[shareToken]/vote.html"
				},
				{
					"source": "/fr-FR/search/dish-category-group-votes/**",
					"destination": "/fr-FR/search/dish-category-group-votes/[shareToken]/vote.html"
				},
				{
					"source": "/zh-CN/search/dish-category-group-votes/**",
					"destination": "/zh-CN/search/dish-category-group-votes/[shareToken]/vote.html"
				},
				{
					"source": "/ar-SA/search/dish-category-group-votes/**",
					"destination": "/ar-SA/search/dish-category-group-votes/[shareToken]/vote.html"
				},
				{
					"source": "/ko-KR/search/dish-category-group-votes/**",
					"destination": "/ko-KR/search/dish-category-group-votes/[shareToken]/vote.html"
				},
				{
					"source": "/es-ES/search/dish-category-group-votes/**",
					"destination": "/es-ES/search/dish-category-group-votes/[shareToken]/vote.html"
				},
				{
					"source": "/hi-IN/search/dish-category-group-votes/**",
					"destination": "/hi-IN/search/dish-category-group-votes/[shareToken]/vote.html"
				},
				{
					"source": "**",
					"destination": "/index.html"
				}
			]
		},
		{
			"site": "nanitabeyo-dev",
			"public": "app-expo/dist",
			"ignore": [
				"firebase.json",
