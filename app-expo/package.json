{
	"name": "app-expo",
	"main": "expo-router/entry",
	"version": "1.14.0",
	"private": true,
	"scripts": {
		"dev": "expo start --dev-client --tunnel",
		"start": "expo start",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web",
		"build:web": "node ./scripts/generate-sitemap.mjs && expo export --platform web",
		"generate:sitemap": "node ./scripts/generate-sitemap.mjs",
		"build:e2e-check-native": "expo export -p android -p ios --output-dir dist-e2e-check",
		"assert:no-e2e-hook": "node ./scripts/assert-no-e2e-hook.mjs",
		"assert:remote-config-defaults": "node ./scripts/assert-remote-config-defaults.mjs",
		"assert:legacy-blur-modal-boundary": "node ./scripts/assert-legacy-blur-modal-boundary.mjs",
		"assert:no-hardcoded-colors": "node ./scripts/assert-no-hardcoded-colors.mjs",
		"lint": "expo lint .",
		"typecheck": "tsc -p tsconfig.dev.json --noEmit",
		"test": "jest",
		"test:watch": "jest --watchAll",
		"reset": "node ./scripts/reset-project.js"
	},
