.env
out/*.json
!out/.gitkeep
# #1273 【設計】目視ラベルだけは例外でコミットする。これは測定の**出力**ではなく
# 人が読んで付けた**判断**であり、スクリプトを回し直しても再現できない。
# コンテナが消えると失われるので、生データと違って版に残す必要がある。
!out/*_labels*.json
!out/*labels_*.json
.venv/
__pycache__/
.ruff_cache/

# #1273 【設計】ワークフローのverifyエージェントが検証中に取得した生データ(HTML/画像/JSONL)。
# 「画像・動画バイナリは取得・保存しない」というPoCの方針上、コミットしない。
# 判定結果を要約したMarkdownレポート(out/idea_verification/*.md)だけをコミット対象にする。
out/idea_verification/raw/
out/idea_verification/thumbs/
out/idea_verification/handle_test/
out/idea_verification/*.jsonl
out/idea_verification/*.err
out/idea_verification/_*
out/idea_verification/verify.py
out/idea_verification/verify_results.json
out/*.log

# #1273 施設テナントの目視検証で落としたテナント画像とコンタクトシート。
# 上と同じ理由（画像バイナリはコミットしない）。目視の結果は REPORT.md に書く。
out/facility_photo_images/
out/contact_*.jpg
out/_blog_text/
out/_blog_policy_text/
out/_shorts_thumbs/
# #1273 【事故】自社サイト画像の目視検証で落とした 14 枚を、cwd を間違えたまま
#   `git add -A` して**コミットしてしまった**（画像バイナリはコミットしない方針）。
#   目視の結果は out/own_site_dish_image_labels.json と REPORT.md に残す。
out/_own_site_imgs/
out/_blog_imgs/

# #1273 【設計】BigQuery の集計結果は例外でコミットする。目視ラベルと同じ理由で、
# **ローカルのスクリプトを回し直しても再現できない**（外部データへのクエリが要る）。
# SQL は measure_website_column_structure.py の末尾に丸ごと入れてあるので、
# BigQuery が使える環境では引き直せる。
!out/website_column_structure.json
!out/platform_link_coverage.json
!out/blog_contact_route.json
!out/blog_yield_both_sides_audited.json
!out/shorts_area_first_eval.json
!out/shorts_area_first_v2_eval.json
!out/shorts_area_first_pool.json
!out/shorts_store_linkability.json
!out/instagram_handle_reach.json
!out/shorts_longtail_pool.json
!out/shorts_longtail_tail.json
!out/openverse_license_supply.json
!out/license_source_attribution.json
!out/fb_dish_photo_worksheet.csv
!out/fb_dish_photo_worksheet_seed.tsv
!out/manual_import_rate_worksheet.csv
!out/instagram_professional_worksheet.csv
!out/handle_recovery.json
!out/store_source_tos_survey.md
!out/handle_recovery_labels.json
!out/handle_source_host_counts.json
!out/recovery_name_gate.json
out/.ig_token
!out/ig_business_discovery.json
!out/osm_instagram_tag_count.json
!out/ig_api_capability_matrix.md
!out/ig_handle_source_ideas.md
out/_ig_source_ideas/
out/.hf_token
out/.ig_token
!out/tiktok_author_handle_labels.json
!out/foursquare_jp_instagram.json
!out/ig_handle_gate.json
!out/phase0_bd.json
!out/fsq_hf_api_counts.json
!out/ig_handle_gate_at_scale.json
!out/wikidata_ig_handles.json
!out/fsq_gate_at_scale.json
!out/fsq_jp_instagram_counts.json
!out/fsq_jp_ig_gated.csv.gz
!out/NOTICE.txt
