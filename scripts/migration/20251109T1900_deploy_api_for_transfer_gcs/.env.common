# .env.common — shared across develop/production
PROJECT_ID=food-scroll
REGION=asia-northeast1
STORAGE_CLASS=STANDARD
UBLA=true

# Buckets (new)
PUBLIC_BUCKET=nanitabeyo-public
PRIVATE_BUCKET=nanitabeyo-private

# CORS origins (create-gcs-cors.sh uses default "*", as requested)
CORS_ORIGINS=*

# CDN hosts & keys
CDN_PUBLIC_HOST=cdn-public.nanitabeyo.net
CDN_PRIVATE_HOST=cdn.nanitabeyo.net
CDN_PUBLIC_KEY_NAME=cdn-public-key-20251109
CDN_PRIVATE_KEY_NAME=cdn-key-20251109
# TTL: omitted to use infra script defaults

# Transfer
# Old public: not used (no copy)
# Old private:
OLD_PRIVATE_BUCKET=food-scroll.firebasestorage.app

# Prefixes
DEV_PREFIX=development/
PROD_PREFIX=production/
